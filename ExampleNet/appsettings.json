{
  "Settings": {
    "TimeSpan": 5,
    "ShutdownTimeout": 10
  },
  "ElasticApm": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": "Warning",
    "WriteTo": [
      {
        "Name": "Console",
        "Formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://localhost:50001"
      }
    }
  }
}
