{
  "Settings": {
    "TimeSpan": 5
  },
  "ElasticApm": {
    "ServerUrls": "https://example.com",
    "ServiceName": "example-net",
    "Environment": "Development",
    "ApiKey": "dummy==",
    "MetricsInterval": "2m",
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:50001"
      }
    }
  }
}
