{
  "Settings": {
    "TimeSpan": 5
  },
  "ElasticApm": {
    "ServerUrls": "https://example.com",
    "ServiceName": "example-net",
    "Environment": "Development",
    "ApiKey": "dummy==",
    "MetricsInterval": "2m",
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
      },
      {
        "Name": "Elasticsearch",
        "restrictedToMinimumLevel": 9, //9 lvl = disable Elastic logs, 1=Error, 2=Warning, 3=Information, 4=Debug
        "Args": {
          "nodeUris": "https://example.com",
          "indexFormat": "example-net-index-{0:yyyy}",
          "connectionGlobalHeaders": "Authorization=Basic dummybase64encoded="
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://localhost:50001"
      }
    }
  }
}
