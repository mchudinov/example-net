<Project Sdk="MSTest.Sdk/4.5.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Test project is never published; a solution-level publish skips it. -->
    <IsPublishable>false</IsPublishable>
    <!-- Adds the GitHub Actions report extension; CI uses it to write the job summary. -->
    <EnableMicrosoftTestingExtensionsGitHubActionsReport>true</EnableMicrosoftTestingExtensionsGitHubActionsReport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExampleNet\ExampleNet.csproj" />
  </ItemGroup>

</Project>
